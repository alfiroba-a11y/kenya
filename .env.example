HASHPAY_API_KEY=hp_live_replace_me
HASHPAY_ORGANIZATION_ID=pub_org_replace_me
# HashBack HashPay public account ID used by the M-Pesa STK checkout.
HASHPAY_ACCOUNT_ID=HP_replace_me
HASHPAY_WEBHOOK_SECRET=replace_with_webhook_signing_secret
# Optional override for the signed HashPay callback destination. XCROW uses
# https://xcrow.online/webhooks/hashpay by default.
HASHPAY_WEBHOOK_URL=https://xcrow.online/webhooks/hashpay
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/xcrow
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_EMAILS=your-admin-email@example.com
# Private password accepted only by the protected /#admin portal.
ADMIN_PASSWORD=replace_with_a_long_unique_admin_password
# Optional display name used only when XCROW creates the protected administrator record.
ADMIN_NAME=XCROW Administrator
# Optional: Configure your approved Kenyan-shilling payment provider on the server.
KES_PAYMENT_INSTRUCTIONS=Contact support for Kenyan shilling payment instructions.
# KES equivalent of 1 USD/USDT. Set and review this operational rate before accepting crypto payments.
USD_KES_RATE=130
